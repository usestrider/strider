{
  "name": "effect-browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Type-checked sketch of the effect-browser public API. Declarations only; nothing here runs.",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./ai": "./src/ai/index.ts",
    "./bidi": "./src/bidi/index.ts",
    "./chromium": "./src/chromium/index.ts",
    "./cli": "./src/cli/index.ts",
    "./firefox": "./src/firefox/index.ts",
    "./test": "./src/test/index.ts",
    "./test/vitest": "./src/test/vitest/index.ts",
    "./webkit": "./src/webkit/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "scripts": {
    "check": "tsc --noEmit -p . && node scripts/barrel.mjs --check && effect-language-service diagnostics --project tsconfig.json",
    "barrel": "node scripts/barrel.mjs",
    "jsdocs": "node scripts/jsdocs.mjs",
    "examples": "node scripts/examples.mjs",
    "test-types": "tstyche",
    "index": "node scripts/index.mjs",
    "api-reference": "node scripts/api-reference.mjs",
    "all": "npm run check && npm run jsdocs && npm run examples && npm run test-types && npm run index && npm run api-reference"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "effect": "4.0.5",
    "tstyche": "^7.2.5",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3"
  }
}
