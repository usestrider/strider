{
  "name": "@usestrider/vitest",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "homepage": "https://usestrider.dev",
  "description": "Vitest for @usestrider/browser: the current test as TestRun, and its artifacts",
  "repository": {
    "type": "git",
    "url": "https://github.com/usestrider/strider.git",
    "directory": "packages/vitest"
  },
  "bugs": {
    "url": "https://github.com/usestrider/strider/issues"
  },
  "keywords": [
    "effect",
    "typescript",
    "browser",
    "vitest"
  ],
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "INDEX.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./index": null
    }
  },
  "scripts": {
    "codegen": "strider-utils barrel",
    "build": "node ../tools/docs/src/bin.mjs index --package vitest && tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json",
    "prepack": "node ../tools/docs/src/bin.mjs index --package vitest"
  },
  "peerDependencies": {
    "@usestrider/browser": "workspace:^",
    "effect": "^4.1.2",
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@usestrider/browser": "workspace:^",
    "@usestrider/utils": "workspace:^",
    "effect": "^4.1.2",
    "vitest": "^5.0.5"
  }
}
