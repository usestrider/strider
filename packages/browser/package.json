{
  "name": "@usestrider/browser",
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://usestrider.dev",
  "description": "Effect-native browser automation over CDP, WebDriver BiDi and the WebKit inspector protocol",
  "repository": {
    "type": "git",
    "url": "https://github.com/usestrider/strider.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/usestrider/strider/issues"
  },
  "keywords": [
    "effect",
    "typescript",
    "browser",
    "automation",
    "cdp",
    "webdriver-bidi"
  ],
  "sideEffects": [
    "./src/bin/strider.ts",
    "./dist/bin/strider.js"
  ],
  "bin": {
    "strider": "./src/bin/strider.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./ai": "./src/ai/index.ts",
    "./bidi": "./src/bidi/index.ts",
    "./bidi-protocol": "./src/bidi-protocol/index.ts",
    "./cdp": "./src/cdp/index.ts",
    "./chromium": "./src/chromium/index.ts",
    "./cli": "./src/cli/index.ts",
    "./firefox": "./src/firefox/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./test": "./src/test/index.ts",
    "./webkit": "./src/webkit/index.ts",
    "./webkit-stock-protocol": "./src/webkit-stock-protocol/index.ts",
    "./webkit-automation-protocol": "./src/webkit-automation-protocol/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./bin/*": null,
    "./index": null,
    "./*/index": null,
    "./experimental": "./src/experimental/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "INDEX.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "bin": {
      "strider": "./dist/bin/strider.js"
    },
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./ai": "./dist/ai/index.js",
      "./bidi": "./dist/bidi/index.js",
      "./bidi-protocol": "./dist/bidi-protocol/index.js",
      "./cdp": "./dist/cdp/index.js",
      "./chromium": "./dist/chromium/index.js",
      "./cli": "./dist/cli/index.js",
      "./firefox": "./dist/firefox/index.js",
      "./protocol": "./dist/protocol/index.js",
      "./test": "./dist/test/index.js",
      "./webkit": "./dist/webkit/index.js",
      "./webkit-stock-protocol": "./dist/webkit-stock-protocol/index.js",
      "./webkit-automation-protocol": "./dist/webkit-automation-protocol/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./bin/*": null,
      "./index": null,
      "./*/index": null,
      "./experimental": "./dist/experimental/index.js"
    }
  },
  "scripts": {
    "codegen": "strider-utils barrel",
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.0.6",
    "effect": "^4.0.6"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-node": "^4.0.6",
    "@usestrider/utils": "workspace:^",
    "effect": "^4.0.6"
  }
}
