diff --git a/packages/browser/src/internal/redirectCapture.ts b/packages/browser/src/internal/redirectCapture.ts
new file mode 100644
index 00000000..4ade4c5a
--- /dev/null
+++ b/packages/browser/src/internal/redirectCapture.ts
@@ -0,0 +1,42 @@
+/** Temporary redirect diagnostics; apply redirectCapture.patch to connect the hooks. */
+import * as Effect from "effect/Effect"
+import * as Stream from "effect/Stream"
+import * as fs from "node:fs"
+import type * as Transport from "../protocol/Transport.ts"
+import type * as Adapter from "./adapter.ts"
+
+let sequence = 0
+let connection = 0
+export const capture = (kind: string, value: unknown) => {
+  const directory = process.env["STRIDER_RECORD"]
+  if (!directory) return
+  fs.mkdirSync(directory, { recursive: true })
+  fs.appendFileSync(
+    `${directory}/redirect-${process.pid}.ndjson`,
+    JSON.stringify({
+      sequence: ++sequence,
+      at: Date.now(),
+      kind,
+      value
+    }) + "\n"
+  )
+}
+
+export const wrap = (transport: Transport.Transport, sink: Adapter.Sink) => {
+  const id = ++connection
+  capture("connection", { id })
+  return {
+    transport: {
+      send: (message: string) =>
+        Effect.andThen(
+          Effect.sync(() => capture("send", { id, message: JSON.parse(message) })),
+          transport.send(message)
+        ),
+      messages: transport.messages.pipe(
+        Stream.tap((message) => Effect.sync(() => capture("receive", { id, message: JSON.parse(message) })))
+      ),
+      closed: transport.closed
+    },
+    sink: (fact: Adapter.Fact) => Effect.andThen(Effect.sync(() => capture("fact", { id, fact })), sink(fact))
+  }
+}
