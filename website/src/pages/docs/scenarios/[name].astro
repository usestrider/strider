---
// A scenario: what it shows, its program as it runs, what it returns, and the API it calls
import { Code } from "astro-expressive-code/components"
import Rail from "../../../components/Rail.astro"
import ScenarioNav from "../../../components/ScenarioNav.astro"
import { type Scenario, scenarios } from "../../../features/scenarios/scenarios.ts"
import DocShell from "../../../layouts/DocShell.astro"

export const getStaticPaths = () => scenarios().map((scenario) => ({ params: { name: scenario.name }, props: { scenario } }))

const { scenario } = Astro.props as { scenario: Scenario }
const sites: Record<string, string> = {
  "the-internet": "The Internet, a site of examples for practicing automation"
}
// A public demo site is replayed from a recording; any other scenario drives a page of the local site
const site = scenario.recording === undefined
  ? undefined
  : `${sites[scenario.recording] ?? scenario.recording}, replayed from a recording of the site`
---

<DocShell
  title={scenario.title}
  description={scenario.description}
  area="scenarios"
  crumbs={[{ label: "Scenarios", href: "/docs/scenarios" }, { label: scenario.title }]}
>
  <ScenarioNav slot="sidebar" current={scenario.name} />
  <Rail
    slot="rail"
    groups={[
      { label: "The program", href: "#program" },
      { label: "What it calls", href: "#calls" }
    ]}
  />
  <p class="label">Scenario</p>
  <h1 class="mt-2 font-display text-[3rem] leading-tight font-normal">{scenario.title}</h1>
  <p class="deck mt-3 mb-10 text-[1.3rem] leading-snug">{scenario.description}</p>
  <article class="prose">
    <h2 id="program">The program</h2>
    <p>
      It drives {site ?? <>a page of its own, served locally at <code>origin</code></>}, and returns
      <code>{scenario.expected}</code>.
    </p>
    <Code code={scenario.code} lang="ts" />
    <h2 id="calls">What it calls</h2>
    <ul>
      {
        scenario.uses.map((use) => (
          <li>
            <a href={use.href}>
              <code>{use.label}</code>
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</DocShell>
