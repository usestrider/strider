---
// A scenario: what it shows, its program as it runs, what it returns, and the API it calls
import { Code } from "astro-expressive-code/components"
import Rail from "../../../components/Rail.astro"
import ScenarioNav from "../../../components/ScenarioNav.astro"
import { type Scenario, scenarioRoute, scenarios } from "../../../features/scenarios/scenarios.ts"
import DocShell from "../../../layouts/DocShell.astro"

export const getStaticPaths = () => scenarios().map((scenario) => ({ params: { name: scenario.name }, props: { scenario } }))

const { scenario } = Astro.props as { scenario: Scenario }
const browserNames = { chromium: "Chromium", firefox: "Firefox" } as const
// The same program on another browser, shown beside this one
const other = scenario.compare === undefined
  ? undefined
  : scenarios().find((candidate) => candidate.name === scenario.compare)
if (scenario.compare !== undefined && other === undefined) {
  throw new Error(`The scenario ${scenario.name} compares itself with ${scenario.compare}, which doesn't exist`)
}
const sites: Record<string, string> = {
  "the-internet": "The Internet, a site of examples for practicing automation"
}
// A public demo site is replayed from a recording; any other scenario drives a page of the local site
const site = scenario.recording === undefined
  ? undefined
  : `${sites[scenario.recording] ?? scenario.recording}, replayed from a recording of the site`
---

<DocShell
  title={scenario.title}
  description={scenario.description}
  area="scenarios"
  crumbs={[{ label: "Scenarios", href: "/docs/scenarios" }, { label: scenario.title }]}
>
  <ScenarioNav slot="sidebar" current={scenario.name} />
  <Rail
    slot="rail"
    groups={[
      { label: "The program", href: "#program" },
      ...(scenario.video === undefined ? [] : [{ label: "The run", href: "#run" }]),
      ...(other === undefined ? [] : [{ label: `On ${browserNames[other.browser]}`, href: "#compare" }]),
      { label: "What it calls", href: "#calls" }
    ]}
  />
  <p class="label">Scenario</p>
  <h1 class="mt-2 font-display text-[3rem] leading-tight font-normal">{scenario.title}</h1>
  <p class="deck mt-3 mb-10 text-[1.3rem] leading-snug">{scenario.description}</p>
  <article class="prose">
    <h2 id="program">The program</h2>
    <p>
      {scenario.browser === "firefox" ? "On Firefox, it" : "It"} drives {
        site ?? <>a page of its own, served locally at <code>origin</code></>
      }, and returns
      <code>{scenario.expected}</code>.
    </p>
    <Code code={scenario.code} lang="ts" />
    {
      scenario.video !== undefined && (
        <>
          <h2 id="run">The run</h2>
          <p>The video it recorded, in one run:</p>
          <video src={`/videos/${scenario.video}`} width="1280" height="720" controls muted loop playsinline />
        </>
      )
    }
    {
      other !== undefined && (
        <>
          <h2 id="compare">On {browserNames[other.browser]}</h2>
          <p>
            <a href={scenarioRoute(other)}>{other.title}</a>: {other.description}
          </p>
          <Code code={other.code} lang="ts" />
          {
            other.video !== undefined && (
              <video src={`/videos/${other.video}`} width="1280" height="720" controls muted loop playsinline />
            )
          }
        </>
      )
    }
    <h2 id="calls">What it calls</h2>
    <ul>
      {
        scenario.uses.map((use) => (
          <li>
            <a href={use.href}>
              <code>{use.label}</code>
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</DocShell>
