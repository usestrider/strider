---
// Every guide and reference page: the masthead, the band with where the page is, a navigation sidebar, the page,
// and a rail for what's on it
import SiteHeader from "../components/SiteHeader.astro"
import BaseLayout from "./BaseLayout.astro"

interface Props {
  readonly title: string
  readonly description?: string | undefined
  readonly area: "guides" | "scenarios" | "reference"
  /** Where the page is: GUIDE / CHAPTER 1 / START HERE */
  readonly crumbs: ReadonlyArray<{ readonly label: string; readonly href?: string | undefined }>
}

const { title, description, area, crumbs } = Astro.props
---

<BaseLayout title={title} description={description}>
  <SiteHeader area={area} />
  <nav class="bg-band px-6 py-2.5" aria-label="Breadcrumb">
    <ol class="label flex flex-wrap gap-2 !text-white">
      {
        crumbs.map((crumb, i) => (
          <li class="flex gap-2">
            {i > 0 && <span class="opacity-70">/</span>}
            {crumb.href === undefined ? <span>{crumb.label}</span> : <a href={crumb.href}>{crumb.label}</a>}
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="grid md:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,1fr)_15rem]">
    <aside
      class="sticky top-0 hidden h-screen overflow-y-auto border-r border-hairline px-6 pb-16 md:block"
      data-sidebar
    >
      <slot name="sidebar" />
    </aside>
    <script is:inline>
      // The sidebar opens with the current page in view. Inline, so it runs as the sidebar is parsed, before the
      // first paint; a module script runs after the whole page is parsed, and the sidebar would jump.
      {
        const sidebar = document.querySelector("[data-sidebar]")
        const current = sidebar?.querySelector("[aria-current='page']")
        if (sidebar && current) sidebar.scrollTop = current.offsetTop - sidebar.clientHeight / 3
      }
    </script>
    <main class:list={["min-w-0 px-6 pt-10 pb-24 md:px-14", area === "reference" && "reference"]}>
      <div class="max-w-[46rem]"><slot /></div>
    </main>
    <aside class="sticky top-0 hidden h-screen overflow-y-auto pt-10 pr-6 pb-16 xl:block">
      <slot name="rail" />
    </aside>
  </div>
</BaseLayout>
