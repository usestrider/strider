---
import { Font } from "astro:assets"
import BackToTop from "../components/BackToTop.astro"
import SiteFooter from "../components/SiteFooter.astro"
import "../styles/global.css"

interface Props {
  readonly title: string
  readonly description?: string | undefined
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Strider" ? title : `${title} · Strider`}</title>
    {description !== undefined && description !== "" && <meta name="description" content={description} />}
    <link rel="icon" href="/heron.svg" type="image/svg+xml" />
    <Font cssVariable="--font-garamond" preload />
    <Font cssVariable="--font-source-serif" preload />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex" preload />
    <script is:inline>
      // Before first paint, the paper and the band. The paper is night or day as the reader last chose with the
      // masthead's toggle, or as their system prefers. The band is the color of the browser the page is read in, by
      // its brand: Chrome on iOS is Chromium blue, though it runs on WebKit.
      const root = document.documentElement
      const chosen = localStorage.getItem("theme")
      const theme = chosen === "dark" || chosen === "light"
        ? chosen
        : matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light"
      root.dataset.theme = theme
      root.classList.toggle("dark", theme === "dark")
      const ua = navigator.userAgent
      const brand = /\bOPR\//.test(ua)
        ? "opera"
        : /\bEdg(A|iOS)?\//.test(ua)
        ? "edge"
        : /\b(Firefox|FxiOS)\//.test(ua)
        ? "firefox"
        : /AppleWebKit\//.test(ua) && !/(Chrome|Chromium|CriOS)\//.test(ua)
        ? "webkit"
        : "chromium"
      // Unless the reader picked an engine's color on the cover, which is remembered
      const picked = localStorage.getItem("engine")
      root.dataset.engine = picked === "chromium" || picked === "firefox" || picked === "webkit" ? picked : brand
    </script>
  </head>
  <body>
    <slot />
    <SiteFooter />
    <BackToTop />
    <script>
      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null
        const copy = target?.closest<HTMLElement>("[data-copy-text]")
        if (copy?.dataset["copyText"] !== undefined) void navigator.clipboard.writeText(copy.dataset["copyText"])
      })
    </script>
  </body>
</html>
