---
import { Font } from "astro:assets"
import BackToTop from "../components/BackToTop.astro"
import SiteFooter from "../components/SiteFooter.astro"
import "../styles/global.css"

interface Props {
  readonly title: string
  readonly description?: string | undefined
}

const { title, description } = Astro.props
const pageTitle = title === "Strider" ? title : `${title} · Strider`
// A link preview, on every page: the page's title and description over the one image, from public/. Its URL is the one
// the host serves, with a trailing slash, since it redirects to that
const pageUrl = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site)
const previewImage = new URL("/og.png", Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description !== undefined && description !== "" && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Strider" />
    <meta property="og:title" content={pageTitle} />
    {description !== undefined && description !== "" && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Strider: browser automation, typed end to end, with an engraving of a great blue heron"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/heron.svg" type="image/svg+xml" />
    <!-- Page views, counted without cookies through the site's own Worker (website/worker.ts) -->
    <script is:inline async src="/a/script.js"></script>
    <script is:inline>
      window.plausible = window.plausible || function() {
        ;(plausible.q = plausible.q || []).push(arguments)
      }
      plausible.init = plausible.init || function(i) {
        plausible.o = i || {}
      }
      plausible.init()
    </script>
    <Font cssVariable="--font-garamond" preload />
    <Font cssVariable="--font-source-serif" preload />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex" preload />
    <script is:inline>
      // Before first paint, the paper and the band. The paper is night or day as the reader last chose with the
      // masthead's toggle, or as their system prefers. The band is the color of the browser the page is read in, by
      // its brand: Chrome on iOS is Chromium blue, though it runs on WebKit.
      const root = document.documentElement
      const chosen = localStorage.getItem("theme")
      const theme = chosen === "dark" || chosen === "light"
        ? chosen
        : matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light"
      root.dataset.theme = theme
      root.classList.toggle("dark", theme === "dark")
      const ua = navigator.userAgent
      const brand = /\bOPR\//.test(ua)
        ? "opera"
        : /\bEdg(A|iOS)?\//.test(ua)
        ? "edge"
        : /\b(Firefox|FxiOS)\//.test(ua)
        ? "firefox"
        : /AppleWebKit\//.test(ua) && !/(Chrome|Chromium|CriOS)\//.test(ua)
        ? "webkit"
        : "chromium"
      // Unless the reader picked an engine's color on the cover, which is remembered
      const picked = localStorage.getItem("engine")
      root.dataset.engine = picked === "chromium" || picked === "firefox" || picked === "webkit" ? picked : brand
    </script>
  </head>
  <body>
    <slot />
    <SiteFooter />
    <BackToTop />
    <script>
      const counter = window as { plausible?: (event: string, options: { props: Record<string, string> }) => void }
      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null
        const copy = target?.closest<HTMLElement>("[data-copy-text]")
        if (copy?.dataset["copyText"] !== undefined) void navigator.clipboard.writeText(copy.dataset["copyText"])
        // Copying an install command, from the cover's button or a code block's Copy, is one of the counter's goals:
        // the CLI's install, or the library's
        const command = copy?.dataset["copyText"] ??
          target?.closest<HTMLElement>(".expressive-code .copy button")?.dataset["code"]
        if (command?.startsWith("pnpm add")) {
          const goal = command.includes("@usestrider/cli") ? "Copy CLI install command" : "Copy install command"
          counter.plausible?.(goal, { props: { command } })
        }
      })
    </script>
  </body>
</html>
