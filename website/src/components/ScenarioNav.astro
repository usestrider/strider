---
// The scenarios' sidebar: every scenario, in the order `pnpm scenarios` runs them
import { scenarioRoute, scenarios } from "../features/scenarios/scenarios.ts"
import SideNav from "./SideNav.astro"

interface Props {
  readonly current?: string | undefined
}

const { current } = Astro.props
---

<div class="pt-6"></div>
<SideNav
  label="Scenarios"
  links={scenarios().map((scenario) => ({
    label: scenario.title,
    href: scenarioRoute(scenario),
    current: scenario.name === current
  }))}
/>
