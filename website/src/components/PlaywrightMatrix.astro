---
import { decisionUrl, groups, labels, matrix, members } from "../features/playwright/matrix.ts"
const browsers = [{ id: "chromium", label: "Chromium" }, { id: "firefox", label: "Firefox" }, { id: "webkit", label: "Stock WebKitGTK" }]
---

<div class="playwright-matrix">
  <p>{matrix.rows.length} capability and option rows, covering {members.size} upstream members.</p>
  <div class="matrix-controls not-prose">
    <label>Find a capability <input type="search" data-matrix-search placeholder="e.g. screenshot, route, TestConfig" /></label>
    <label>Classification in any launched or attached browser mode <select data-matrix-status>
      <option value="">All</option>
      <option value="has">Has it</option>
      <option value="different">Deliberately different</option>
      <option value="missing">Missing in any mode</option>
    </select></label>
    <button type="button" data-matrix-expand>Expand all</button>
  </div>
  {groups.map((group) => (
    <details class="matrix-group" id={`class-${group.name.toLowerCase()}`}>
      <summary>{group.name} <span>({group.rows.length} rows; {group.directory})</span></summary>
      {group.extends && <p>Extends {group.extends}; inherited members are listed under that class.</p>}
      {group.rows.length === 0 && <p>No JavaScript members declared in this reference class.</p>}
      <div class="capabilities not-prose">
        <table>
          <thead><tr><th scope="col">Playwright capability</th>{browsers.map((browser) => <th scope="col">{browser.label}</th>)}<th scope="col">Strider API and differences</th></tr></thead>
          <tbody>
            {group.rows.map((row) => {
              const member = members.get(row.upstream[0])!
              return (
                <tr id={row.id} data-matrix-row data-search={`${member.class}.${member.name} ${row.option ?? ""} ${row.value ?? ""} ${row.notes}`.toLowerCase()} data-statuses={Object.values(row.browsers).map((entry) => entry.status).join(" ")}>
                  <th scope="row"><a href={member.url}><code>{member.class}.{member.name}{row.option ? ` · ${row.option}` : ""}{row.value ? ` = ${row.value}` : ""}</code></a><small>{member.kind}{member.deprecated ? "; deprecated upstream" : ""} · {member.since}</small></th>
                  {browsers.map((browser) => {
                    const launched = row.browsers[`${browser.id}.launched`]
                    const attached = row.browsers[`${browser.id}.attached`]
                    const differs = JSON.stringify(launched) !== JSON.stringify(attached)
                    return <td data-status={launched.status === "missing" ? "unsupported" : "supported"}>
                      {labels[launched.status]}
                      {launched.limitations.length > 0 && <small>{launched.limitations.join(" ")}</small>}
                      {differs && <small>Attached: {labels[attached.status]}. {attached.limitations.join(" ")}</small>}
                    </td>
                  })}
                  <td>{row.api.map((api, index) => <Fragment>{index > 0 && ", "}<a href={api.url}><code>{api.module}.{api.symbol}</code></a></Fragment>)}<p>{row.notes}</p>
                    {row.parent && <p><a href={`#${row.parent}`}>Capability containing this value gap</a></p>}
                    {row.gaps && <p>Value gaps: {row.gaps.map((id, index) => <Fragment>{index > 0 && ", "}<a href={`#${id}`}>{matrix.rows.find((gap) => gap.id === id)?.value}</a></Fragment>)}</p>}
                    {row.patches?.map((id) => <p><a href={`#patch-${id}`}>{matrix.patchedBrowserNotes.find((note) => note.id === id)?.id}: patched-browser evidence</a></p>)}
                    {row.decision && <p><a href={decisionUrl(row.decision)}>Design decision</a><small>“{row.decision.quote}”</small></p>}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    </details>
  ))}
</div>

<script>
  const root = document.querySelector(".playwright-matrix")!
  const search = root.querySelector<HTMLInputElement>("[data-matrix-search]")!
  const status = root.querySelector<HTMLSelectElement>("[data-matrix-status]")!
  const groups = root.querySelectorAll<HTMLDetailsElement>(".matrix-group")
  let priorOpen: Map<HTMLDetailsElement, boolean> | undefined
  const filter = () => {
    const active = Boolean(search.value || status.value)
    if (active && !priorOpen) priorOpen = new Map([...groups].map((group) => [group, group.open]))
    for (const group of groups) {
      let visible = 0
      for (const row of group.querySelectorAll<HTMLTableRowElement>("[data-matrix-row]")) {
        row.hidden = !(row.dataset.search!.includes(search.value.toLowerCase()) && (!status.value || row.dataset.statuses!.split(" ").includes(status.value)))
        if (!row.hidden) visible++
      }
      group.hidden = visible === 0
      if (active) group.open = visible > 0
      else if (priorOpen) group.open = priorOpen.get(group) ?? false
    }
    if (!active) priorOpen = undefined
  }
  search.addEventListener("input", filter)
  status.addEventListener("change", filter)
  root.querySelector("[data-matrix-expand]")!.addEventListener("click", () => {
    const open = [...groups].some((group) => !group.hidden && !group.open)
    for (const group of groups) group.open = open
  })
  const reveal = () => {
    const row = document.getElementById(decodeURIComponent(location.hash.slice(1)))
    const group = row?.closest<HTMLDetailsElement>("details")
    if (group) {
      if (search.value || status.value) { search.value = ""; status.value = ""; filter() }
      group.open = true; row?.scrollIntoView()
    }
  }
  window.addEventListener("hashchange", reveal)
  reveal()
</script>

<style>
  .matrix-controls { display: flex; flex-wrap: wrap; gap: 1rem; margin-block: 1.5rem; font-family: var(--font-sans); }
  .matrix-controls label { min-width: 0; max-width: 100%; display: grid; gap: .25rem; }
  .matrix-controls input, .matrix-controls select, .matrix-controls button { border: 1px solid currentColor; min-width: 0; max-width: 100%; padding: .4rem; background: transparent; color: inherit; }
  .matrix-group { border-top: 1px solid var(--hairline); padding-block: .65rem; }
  summary { cursor: pointer; font-weight: 600; }
  summary span { font-weight: 400; font-size: .8em; }
  table { min-width: 60rem; }
  small { display: block; font-size: .8em; font-weight: 400; margin-top: .4rem; }
  td p { margin-block: .5rem; }
  [hidden] { display: none !important; }
</style>
