{
  "name": "@usestrider/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The documentation site: guides, and the API reference generated from the packages",
  "scripts": {
    "dev": "astro dev --port 4390",
    "check": "astro sync && tsc --noEmit",
    "build": "astro build",
    "preview": "astro preview --port 4390",
    "deploy": "sops exec-env deploy.sops.env 'alchemy deploy --stage prod --yes'",
    "social": "node social/render.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-node": "4.1.2",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@usestrider/browser": "workspace:^",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.1.2"
  }
