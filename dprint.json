{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": false,
  "includes": [
    "**/*.{ts,mjs,json}",
    "packages/**/*.md",
    ".agents/**/*.md"
  ],
  "indentWidth": 2,
  "lineWidth": 120,
  "newLineKind": "lf",
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "alwaysDouble",
    "trailingCommas": "never",
    "operatorPosition": "maintain",
    "arrowFunction.useParentheses": "force"
  },
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/*.tsbuildinfo",
    "**/CHANGELOG.md",
    "packages/*/INDEX.md",
    "packages/browser/README.md",
    "packages/scenarios/RESULTS.md",
    "packages/scenarios/upstream/*/fixture/**",
    "packages/tools/docs/src/jsdocs/**",
    "packages/tools/codegen/protocols/*/source/**",
    "packages/tools/codegen/protocols/*/model.json",
    "packages/tools/codegen/protocols/*/coverage.json",
    "**/.*",
    "!.agents",
    "!.agents/**/*",
    "!.changeset",
    "!.changeset/**/*",
    "!.oxlintrc.json"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.93.4.wasm",
    "https://plugins.dprint.dev/markdown-0.20.0.wasm",
    "https://plugins.dprint.dev/json-0.21.1.wasm"
  ]
}
