    {
      "id": "firefox-build",
      "browsers": [
        "firefox"
      ],
      "note": "Playwright requires its patched Firefox; Strider drives stock Firefox over WebDriver BiDi. This is a transport/build distinction, not proof that every Firefox feature requires a patch.",
      "evidence": [
        {
          "file": "docs/src/browsers.md",
          "text": "branded version of Firefox since it relies on patches.",
          "line": 584,
          "url": "https://github.com/microsoft/playwright/blob/606ecd8b34bac100db32561b6278ffd76e5eb3cd/docs/src/browsers.md#L584"
        }
      ],
      "rows": [],
      "scope": "build"
    },
    {
      "id": "webkit-build",
      "browsers": [
