--- a/.github/workflows/integration.yml
+++ b/.github/workflows/integration.yml
@@ -82,3 +82,37 @@
             .data/integration-failures/
           include-hidden-files: true
           retention-days: 14
+
+  integration-macos:
+    needs: [changed, integration]
+    # Keep macOS findings visible even when Linux fails; respect the nightly unchanged-main gate.
+    if: always() && needs.changed.outputs.run == 'true' && needs.integration.result != 'cancelled'
+    runs-on: macos-15
+    timeout-minutes: 60
+    defaults:
+      run:
+        shell: bash
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5.0.0
+        with:
+          node-version: '24'
+      - name: Install pnpm
+        run: npm install --global pnpm@12.9.0
+      - name: Install TLS fixture tool
+        run: brew install openssl@3
+      - name: Install
+        run: pnpm install --frozen-lockfile
+      # No AppArmor, /proc core handler or Xvfb on macOS. Headed cases use WindowServer.
+      - name: macOS Chromium and Firefox integration tests
+        run: pnpm test:integration:macos --no-file-parallelism 2>&1 | tee integration-macos.log
+      - name: Keep the macOS log
+        if: failure()
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: integration-macos-log
+          path: |
+            integration-macos.log
+            .data/integration-failures/
+          include-hidden-files: true
+          retention-days: 14
