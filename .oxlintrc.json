{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/*.tsbuildinfo",
    "packages/tools/docs/src/jsdocs/**",
    "packages/scenarios/upstream/*/fixture/**",
    "**/.*"
  ],
  "overrides": [{
    "files": ["**/{test,typetest,scenarios,scripts}/**", "packages/tools/**"],
    "rules": {
      "eslint/no-console": "off"
    }
  }]
}
